void setup() {
  Serial.begin(115200);
  u8g2.setBusClock(400000);
  u8g2.begin();
  u8g2.clearBuffer();
  u8g2.sendBuffer();
}

void loop() {
  static uint16_t idx = 0;
  static unsigned long t = 0;
  if (millis() - t >= FRAME_MS) {
    t = millis();
    u8g2.clearBuffer();
    // Same MSB-first, row-major format as Adafruit drawBitmap: 16 bytes/row, 64 rows.
    u8g2.drawBitmap(0, 0, 16, 64, frames[idx]);
    u8g2.sendBuffer();
    idx = (idx + 1) % FRAME_COUNT;
  }
}
